+    /// app only asks and then re-reads the list.
+    func deleteSession(_ id: String) async {
+        var request = URLRequest(url: client.origin.appendingPathComponent("session-delete/delete"))
+        request.httpMethod = "POST"
+        request.setValue("application/json", forHTTPHeaderField: "content-type")
+        request.httpBody = try? JSONEncoder().encode(["sessionId": id])
+        do {
+            let (data, response) = try await client.session.data(for: request)
+            let status = (response as? HTTPURLResponse)?.statusCode ?? 0
+            guard status == 200 else {
+                let failure = Self.deleteFailure(status: status, data: data)
+                Haptics.error()
+                showToast(failure, tone: .warning)
+                return
+            }
+            Haptics.success()
+            await refreshSessions()
+            showToast(String(localized: "已删除"), tone: .success)
+        } catch {
+            Haptics.error()
+            showToast(error.localizedDescription, tone: .warning)
+        }
+    }
