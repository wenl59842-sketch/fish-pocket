index 0000000..32ae206
--- /dev/null
+++ b/engine/plugins/session-delete/index.mjs
@@ -0,0 +1,191 @@
+// Engine side of 「删除会话」: the drawer's swipe action and long-press menu ask for
+// one session to be gone for good, and this is the only thing that may touch the
+// three places a session lives in.
+//
+// A row is not a file: the drawer renders the workspace registry (in memory, plus
+// `~/.dsh/storages/workspace.json`), so unlinking the log alone leaves a ghost row
+// that survives every refresh. The registry therefore has to be told too, through
+// its own write chain — `detachSession` / `unpinSession` / `unarchiveSession` — because
+// editing the JSON behind its back is overwritten by the next write.
+//
+// The route is plain HTTP on the engine's own web server, next to `/api/*`: the app
+// already holds the origin and the session cookie, and a route needs no generated
+// RPC schema. Requests are same-origin from the app only.
+import { existsSync, readdirSync, rmSync, statSync } from 'node:fs';
+import path from 'node:path';
+import os from 'node:os';
+
+export const name = 'session-delete';
+export const inject = ['webServer'];
+
+/** `session-<uuid>`; anything else (a path, a title, an empty string) is refused. */
+const SESSION_RE = /^session-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;
+/** A session written to in the last minute is still running: refuse rather than race it. */
+const ACTIVE_WINDOW_MS = 60 * 1000;
+const BODY_LIMIT = 4 * 1024;
+
+function dshHome() {
+  return process.env.DSH_HOME ?? path.join(os.homedir(), '.dsh');
+}
+
+function sendJson(response, status, value) {
+  response.writeHead(status, { 'cache-control': 'no-store', 'content-type': 'application/json; charset=utf-8' });
+  response.end(JSON.stringify(value));
+}
+
+function readJson(request) {
+  return new Promise((resolve, reject) => {
+    const chunks = [];
+    let size = 0;
+    request.on('data', (chunk) => {
+      size += chunk.length;
+      if (size > BODY_LIMIT) {
+        reject(new Error('body-too-large'));
+        request.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    request.on('end', () => {
+      try {
+        resolve(chunks.length === 0 ? {} : JSON.parse(Buffer.concat(chunks).toString('utf8')));
+      } catch {
+        reject(new Error('bad-json'));
+      }
+    });
+    request.on('error', reject);
+  });
+}
+
+/** Newest write under one session directory; 0 when it cannot be read. */
+function newestWrite(dir) {
+  let newest = 0;
+  for (const entry of readdirSync(dir)) {
+    try {
+      newest = Math.max(newest, statSync(path.join(dir, entry)).mtimeMs);
+    } catch {
+      // A file removed while we look: the next one decides.
+    }
+  }
+  return newest;
+}
+
+/** Every place this session is stored. */
+function locate(home, sessionId) {
+  const targets = [];
+  const root = path.join(home, 'sessions');
+  if (existsSync(root)) {
+    for (const workspace of readdirSync(root)) {
+      const workspaceDir = path.join(root, workspace);
+      if (!existsSync(workspaceDir)) continue;
+      for (const entry of readdirSync(workspaceDir)) {
+        if (entry === sessionId || entry.startsWith(sessionId)) targets.push(path.join(workspaceDir, entry));
+      }
+    }
+  }
+  const cache = path.join(home, 'storages', 'session_projcache', 'sessions', `${sessionId}.json`);
+  if (existsSync(cache)) targets.push(cache);
+  return targets;
+}
+
+/** Drop the session from the workspace registry (the drawer's own data). */
+async function forgetInRegistry(registry, sessionId) {
+  if (registry === undefined || registry === null) return -1;
+  const result = { detached: 0 };
+  try {
+    await registry.unpinSession(sessionId);
+  } catch {
+    // Not pinned.
+  }
+  try {
+    await registry.unarchiveSession(sessionId);
+  } catch {
+    // Not archived.
+  }
+  try {
+    for (const workspace of registry.list()) {
+      if ((workspace.sessionIds ?? []).includes(sessionId)) {
+        await workspace.detachSession(sessionId);
+        result.detached += 1;
+      }
+    }
+  } catch {
+    // Keep what already succeeded.
+  }
+  return result;
+}
+
+/** The one deletion path; the route below is its only caller. */
+export async function deleteSession({ home, registry, sessionId }) {
+  if (typeof sessionId !== 'string' || !SESSION_RE.test(sessionId)) return { ok: false, error: 'bad-session-id' };
+
+  const targets = locate(home, sessionId);
+  if (targets.length === 0) {
+    const cleaned = await forgetInRegistry(registry, sessionId);
+    return { ok: cleaned !== -1, error: cleaned === -1 ? 'not-found' : undefined, files: 0, registry: cleaned };
+  }
+
+  const now = Date.now();
+  for (const target of targets) {
+    try {
+      if (statSync(target).isDirectory() && now - newestWrite(target) < ACTIVE_WINDOW_MS) {
+        return { ok: false, error: 'session-active' };
+      }
+    } catch {
+      // Gone already; continue.
+    }
+  }
+
+  const removed = [];
+  for (const target of targets) {
+    rmSync(target, { recursive: true, force: true });
+    removed.push(target);
+  }
+
+  const cleaned = await forgetInRegistry(registry, sessionId);
+  return { ok: true, sessionId, removed, registry: cleaned };
+}
+
+export function apply(ctx) {
+  const registry = () => {
+    try {
+      return ctx.get?.('workspaceRegistry');
+    } catch {
+      return undefined;
+    }
+  };
+
+  ctx.inject?.(['webServer'], (host) => {
+    const mount = () =>
+      host.webServer.register({
+        kind: 'exact',
+        path: '/session-delete/delete',
+        handler: async (request, response) => {
+          if (request.method !== 'POST') {
+            sendJson(response, 405, { ok: false, error: 'method-not-allowed' });
+            return;
+          }
+          let body;
+          try {
+            body = await readJson(request);
+          } catch (error) {
+            sendJson(response, 400, { ok: false, error: String(error.message ?? error) });
+            return;
+          }
+          // The registry is read per request: it may publish after this plugin mounts.
+          const result = await deleteSession({
+            home: dshHome(),
+            registry: registry() ?? host.workspaceRegistry,
+            sessionId: body?.sessionId,
+          });
+          if (result.ok) sendJson(response, 200, result);
+          else if (result.error === 'session-active') sendJson(response, 409, result);
+          else if (result.error === 'bad-session-id') sendJson(response, 400, result);
+          else sendJson(response, 404, result);
+        },
+      });
+
+    if (typeof host.effect === 'function') host.effect(mount, 'session-delete: route');
+    else mount();
+  });
+}
